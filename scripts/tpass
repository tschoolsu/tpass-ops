#!/usr/bin/env node
// tpass —— tschool 生態系唯一的 ops 入口。
// 服務清單 / port / 目錄的唯一真相 = 並排的 tpass-registry repo（scripts/lib/registry.mjs 載入）。
// 不帶參數 = 互動選單（不用背指令）。
import { createInterface } from "node:readline/promises";
import { enabledServices, services } from "./lib/registry.mjs";

const HELP = `tpass —— tschool 平台開發/部署工具（不帶參數進互動選單）

本機開發
  tpass dev [svc|all]        內層 dev 迴圈（HTTPS + HMR，SSO 全流程可測）
  tpass check [svc|all]      push 前把關：lint + tsc --noEmit
  tpass check env [svc|all]  驗 .env.local 必填 key（真相 = src/config REQUIRED）
  tpass build [svc|all]      pnpm run build
  tpass start [svc|all]      production smoke：build + start:https
  tpass setup                一次性環境準備（mkcert / pnpm install / 金鑰 / DB，冪等）

資料庫（本機）
  tpass db setup [svc]       建 role+db、補 DATABASE_URL、prisma generate+套 schema
  tpass db reset <svc>       drop 後重建（要求輸入服務 id 確認）

主機（全部經 ssh，主機上不裝任何工具）
  tpass deploy [svc|all]     部署（主機端 git pull + build + pm2 reload）
  tpass status               本機 port 探測 + 主機 pm2 狀態
  tpass logs <svc> [-f]      看主機 log（-f 跟隨）
  tpass env get <svc>        看主機 .env.local（密文預設遮罩，--show 顯示）
  tpass env set <svc> K=V    改主機 .env.local（單鍵 upsert；套用需 deploy）
  tpass env unset <svc> K    移除主機 .env.local 的一個 key
  tpass db create <svc>      在主機建 role+db + 寫入遠端 DATABASE_URL（需一次性授權，見 docs/ONBOARDING.md）

備份（排程由主機 cron 跑，這裡是人要介入時的入口）
  tpass backup run [--dry-run]        手動觸發一次主機備份
  tpass backup list                   看備份庫上有哪些備份
  tpass backup restore <日期> <svc>   還原驗證（下載 → Docker postgres:18 → 對照主機列數）
  tpass backup install-cron           裝每日排程
  tpass backup setup                  一次性：主機裝 rclone + 搬 remote 設定上去

其他
  tpass new [id]             登記新服務（寫 tpass-registry + 印人工步驟清單）
  tpass ui                   開本機管理儀表板（瀏覽器 GUI）
  tpass list                 列出註冊表`;

function list() {
  for (const s of services) {
    const db = s.db ? `db=${s.db.name}(${s.db.strategy})` : "no-db";
    const flags = `${s.enabled ? "" : " [停用]"}${s.deployed ? "" : " [未部署]"}`;
    console.log(`  ${s.id.padEnd(10)} ${String(s.port).padEnd(5)} ${s.dir.padEnd(28)} ${db}${flags}`);
  }
}

async function pickService(rl, { allowAll = true } = {}) {
  const opts = enabledServices();
  opts.forEach((s, i) => console.log(`  ${i + 1}. ${s.id}（${s.name}）`));
  if (allowAll) console.log(`  ${opts.length + 1}. 全部`);
  const n = Number((await rl.question("選服務： ")).trim());
  if (allowAll && n === opts.length + 1) return "all";
  const s = opts[n - 1];
  if (!s) {
    console.log("無效選項");
    process.exit(2);
  }
  return s.id;
}

async function menu() {
  console.log("tpass 互動選單 —— 想做什麼？\n");
  const actions = [
    ["啟動本機開發（dev，HMR）", async (rl) => (await import("./lib/dev.mjs")).dev(await pickService(rl))],
    ["push 前檢查（lint + tsc）", async (rl) => (await import("./lib/check.mjs")).check(await pickService(rl))],
    ["production smoke（build + start:https）", async (rl) => (await import("./lib/build.mjs")).start(await pickService(rl))],
    ["部署到主機", async (rl) => (await import("./lib/deploy.mjs")).deploy(await pickService(rl))],
    ["看服務狀態（本機 + 主機）", async () => (await import("./lib/deploy.mjs")).status()],
    ["看主機 log", async (rl) => (await import("./lib/deploy.mjs")).logs(await pickService(rl, { allowAll: false }))],
    ["本機資料庫 setup", async (rl) => (await import("./lib/db.mjs")).dbSetup(await pickService(rl, { allowAll: false }))],
    ["一次性環境準備（setup）", async () => (await import("./lib/build.mjs")).setup()],
    ["手動備份主機資料庫", async () => (await import("./lib/backup.mjs")).backupRun()],
    ["登記新服務（new）", async () => (await import("./lib/scaffold.mjs")).newService()],
    ["開管理儀表板（ui）", async () => (await import("./lib/ui.mjs")).ui()],
  ];
  actions.forEach(([label], i) => console.log(`  ${i + 1}. ${label}`));
  const rl = createInterface({ input: process.stdin, output: process.stdout });
  const n = Number((await rl.question("\n選項： ")).trim());
  const action = actions[n - 1];
  if (!action) {
    console.log("無效選項");
    process.exit(2);
  }
  await action[1](rl);
  rl.close();
}

const [cmd, ...args] = process.argv.slice(2);
switch (cmd) {
  case undefined:
    await menu();
    break;
  case "dev":
    await (await import("./lib/dev.mjs")).dev(args[0]);
    break;
  case "check":
    if (args[0] === "env") (await import("./lib/check.mjs")).checkEnvCmd(args[1]);
    else await (await import("./lib/check.mjs")).check(args[0]);
    break;
  case "build":
    await (await import("./lib/build.mjs")).build(args[0]);
    break;
  case "start":
    await (await import("./lib/build.mjs")).start(args[0]);
    break;
  case "setup":
    await (await import("./lib/build.mjs")).setup();
    break;
  case "db":
    if (args[0] === "setup") {
      const { dbSetup } = await import("./lib/db.mjs");
      const { dbServices } = await import("./lib/registry.mjs");
      for (const id of args[1] ? [args[1]] : dbServices().map((s) => s.id)) await dbSetup(id);
    } else if (args[0] === "reset") await (await import("./lib/db.mjs")).dbReset(args[1]);
    else if (args[0] === "create") (await import("./lib/db.mjs")).dbCreateRemote(args[1]);
    else {
      console.error("用法: tpass db setup [svc] | tpass db reset <svc> | tpass db create <svc>（遠端）");
      process.exit(2);
    }
    break;
  case "env": {
    const env = await import("./lib/env.mjs");
    const [sub, svcId] = args;
    if (sub === "get") env.envGet(svcId, { show: args.includes("--show") });
    else if (sub === "set") {
      const rest = args.slice(2).filter((a) => a !== "--stdin");
      if (args.includes("--stdin")) env.envSet(svcId, rest[0], await env.readStdin());
      else {
        const kv = rest[0] ?? "";
        const eq = kv.indexOf("=");
        if (!svcId || eq < 0) {
          console.error("用法: tpass env set <svc> KEY=VALUE | tpass env set <svc> KEY --stdin");
          process.exit(2);
        }
        env.envSet(svcId, kv.slice(0, eq), kv.slice(eq + 1));
      }
    } else if (sub === "unset") env.envUnset(svcId, args[2]);
    else {
      console.error("用法: tpass env get <svc> [--show] | tpass env set <svc> KEY=VALUE | tpass env unset <svc> KEY");
      process.exit(2);
    }
    break;
  }
  case "deploy":
    (await import("./lib/deploy.mjs")).deploy(args[0] ?? "all");
    break;
  case "status":
    await (await import("./lib/deploy.mjs")).status();
    break;
  case "logs":
    (await import("./lib/deploy.mjs")).logs(args.filter((a) => a !== "-f")[0], args.includes("-f"));
    break;
  case "backup": {
    const b = await import("./lib/backup.mjs");
    const sub = args[0];
    if (sub === "run") b.backupRun(args.includes("--dry-run"));
    else if (sub === "list") b.backupList();
    else if (sub === "restore") await b.backupRestore(args[1], args[2]);
    else if (sub === "install-cron") b.installCron();
    else if (sub === "setup") b.backupSetup();
    else {
      console.error("用法: tpass backup run [--dry-run] | list | restore <日期> <svc> | install-cron | setup");
      process.exit(2);
    }
    break;
  }
  case "new":
    await (await import("./lib/scaffold.mjs")).newService(args[0]);
    break;
  case "ui":
    await (await import("./lib/ui.mjs")).ui();
    break;
  case "list":
    list();
    break;
  case "help":
  case "-h":
  case "--help":
    console.log(HELP);
    break;
  default:
    console.error(`未知指令「${cmd}」\n`);
    console.log(HELP);
    process.exit(2);
}
