# 備份設定範本。複製成 deploy/backup.env 並填值 —— 那份不進 git（含 webhook 機密）。
#   cp deploy/backup.env.example deploy/backup.env
# 這個檔案只存在於主機（~/tpass/deploy/backup.env），本機不需要。

# rclone remote 與路徑。備份腳本對目的地無關：換 R2 / S3 / B2 只改這一行。
# 目前是 Google Drive（rclone config create tpass-backup drive scope=drive.file）。
BACKUP_REMOTE=tpass-backup:tpass-backups

# 備份失敗時通知的 Discord webhook（留空 = 不通知，但那等於回到靜默失敗，別留空）。
BACKUP_DISCORD_WEBHOOK=

# 保留策略（rclone --min-age 語法）。一天備一次 → 7d = 留 7 份日備、28d = 留 4 份週備。
BACKUP_KEEP_DAILY=7d
BACKUP_KEEP_WEEKLY=28d

# 備份成功時 ping 的 Uptime Kuma push URL
# （https://status.tschoolsu.org/api/push/<token>；留空 = 不 ping）。
# 這是第三道防線，擋的是「cron 根本沒觸發」——那時腳本從未執行，
# Discord webhook 不會響，因為沒有東西發得出告警。設定步驟見 docs/ONBOARDING.md §6「備份的死人開關」。
BACKUP_HEARTBEAT_URL=
