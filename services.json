{
  "$comment": "tpass 生態系服務註冊表——唯一真相來源。所有 ops 腳本 / CLI / ecosystem.config.js / deploy.sh 都從這裡讀，不得另行硬編碼服務清單、port、目錄名。欄位說明見 docs/NEW-SERVICE.md 附錄 B。",
  "issuer": "auth",
  "domains": { "dev": "lvh.me", "prod": "tschoolsu.org" },
  "server": { "root": "~/tpass" },
  "services": [
    {
      "id": "auth",
      "name": "T-Pass SSO 發證",
      "dir": "tpass-auth",
      "subdomain": "auth",
      "port": 3000,
      "db": null,
      "enabled": true,
      "deployed": true
    },
    {
      "id": "portal",
      "name": "T-Portal 門戶",
      "dir": "tpass-portal",
      "subdomain": "portal",
      "port": 3001,
      "db": null,
      "enabled": true,
      "deployed": true
    },
    {
      "id": "form",
      "name": "T-Form 問卷",
      "dir": "tpass-form",
      "subdomain": "form",
      "port": 3002,
      "db": { "name": "t_form", "user": "t_form", "strategy": "migrate" },
      "enabled": true,
      "deployed": true
    },
    {
      "id": "msg",
      "name": "T-Msg 跨屆代傳",
      "dir": "tpass-cross_grade_messages",
      "subdomain": "msg",
      "port": 3003,
      "db": { "name": "t_msg", "user": "t_msg", "strategy": "migrate" },
      "enabled": true,
      "deployed": true
    },
    {
      "id": "appeals",
      "name": "T-Appeals 申訴",
      "dir": "tpass-appeals",
      "subdomain": "appeals",
      "port": 3004,
      "db": { "name": "t_appeals", "user": "t_appeals", "strategy": "migrate" },
      "enabled": true,
      "deployed": true
    },
    {
      "id": "directory",
      "name": "T-Directory 目錄（封存）",
      "dir": "tpass-directory",
      "subdomain": "directory",
      "port": 3005,
      "db": { "name": "t_directory", "user": "t_directory", "strategy": "push" },
      "enabled": false,
      "deployed": false,
      "note": "2026-07-05 封存；port 由 3004 移至 3005 解決與 appeals 撞車"
    }
  ]
}
